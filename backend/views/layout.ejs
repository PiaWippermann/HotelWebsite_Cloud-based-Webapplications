<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Palais Vert</title>
    <link rel="stylesheet" href="/styles/layout.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300..800&family=Red+Hat+Text:ital,wght@0,300..700;1,300..700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="icon"
      type="image/png"
      href="/assets/favicon-16x16.png"
      sizes="16x16"
    />
    <link
      rel="icon"
      type="image/png"
      href="/assets/favicon-32x32.png"
      sizes="32x32"
    />
    <link
      rel="icon"
      type="image/png"
      href="/assets/favicon-96x96.png"
      sizes="96x96"
    />
    <link
      rel="icon"
      type="image/png"
      href="/assets/favicon-192x192.png"
      sizes="192x192"
    />

    <script>
      // These variables are set by the server-side rendering
      // and will be used in the client-side script
      window.roomServiceUrl = "<%= roomServiceUrl %>";
      window.eventServiceUrl = "<%= eventServiceUrl %>";
      window.weatherServiceUrl = "<%= weatherServiceUrl %>";
    </script>
  </head>
  <body>
    <header class="main-header">
      <button id="burger" class="burger-btn" aria-label="Menü öffnen">☰</button>
    </header>

    <nav id="overlay" class="overlay-nav">
      <button id="close-btn" aria-label="Menü schließen">×</button>

      <div class="nav-content">
        <ul id="main-nav-list" class="main-nav-list">
          <li class="item-nav">
            <a href="javascript:loadMain()">Startseite</a>
          </li>
          <li class="item-nav">
            <a href="javascript:loadRooms()">Zimmer</a>
          </li>
          <li class="item-nav">
            <a href="javascript:loadEvents()">Events</a>
          </li>
          <li class="item-nav">
            <a href="javascript:loadWeather()">Wetter</a>
          </li>
        </ul>

        <ul id="sub-nav-list" class="sub-nav-list"></ul>
      </div>
    </nav>

    <iframe id="mainIframe"></iframe>

    <script src="/scripts/styling.js"></script>
    <script src="/scripts/routing.js"></script>
  </body>
</html>
