<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300..800&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
      rel="stylesheet"
    />
    <link href="/styles/main.css" rel="stylesheet" />
  </head>
  <body>
    <!-- Content -->
    <section class="hero">
      <div class="hero-image">
        <!-- <img
          src="http://localhost:9002/hotelimpression/header.webp"
          alt="Hero Image"
        /> -->
      </div>
      <div class="hero-overlay">
        <h1 class="display-large">Palais Vert</h1>
      </div>
    </section>

    <section
      class="section content fade-item"
      data-bg="#121A18"
      data-color="#f5f1e6"
    ></section>

    <section class="section content" data-bg="#f5f1e6" data-color="#121A18">
      <div class="info-wrapper fade-item">
        <div class="info-text">
          <h1 class="fade-item">Konfiguration</h1>

          <span
            >Konfiguriere Dein Traumauto noch heute! Gestalte dein
            Wunschfahrzeug bis ins kleinste Detail und mache es
            einzigartig.</span
          >
          <span><a href="/configurator">Zur Konfiguration</a></span>
        </div>
        <div class="info-image">
          <img
            src="http://localhost:9000/main/1750668561680.avif"
            alt="Bild 2"
          />
        </div>
      </div>
    </section>

    <section class="section content" data-bg="#121A18" data-color="#f5f1e6">
      <div class="info-wrapper fade-item">
        <div class="info-image">
          <img
            src="http://localhost:9000/main/1740020364535.avif"
            alt="Bild 2"
          />
        </div>
        <div class="info-text">
          <h1 class="fade-item">Lust auf eine kleine Reise?</h1>

          <span>Lass Dich auf eine unvergessliche Reise ein.</span>
          <span><a href="/route">Zur Route</a></span>
        </div>
      </div>
    </section>

    <section class="section content" data-bg="#f5f1e6" data-color="#121A18">
      <div class="info-wrapper fade-item">
        <div class="info-text">
          <h1 class="fade-item">Kauf dich glücklich</h1>

          <span
            >Entdecke unsere exklusive Auswahl an Shop Artikeln und lasse Dein
            Shopping Herz im Online Shop höher schlagen.</span
          >
          <span><a href="/shop">Zum Online Shop</a></span>
        </div>
        <div class="info-image">
          <img
            src="http://localhost:9000/main/1746786839483.avif"
            alt="Bild 2"
          />
        </div>
      </div>
    </section>

    <script src="/scripts/main.js"></script>
  </body>
</html>
