<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/styles/event.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Funnel+Display:wght@300..800&family=Red+Hat+Text:ital,wght@0,300..700;1,300..700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div id="event-header">
      <h1>Palais Vert - Events</h1>
    </div>
    <div id="event-view">
      <div class="event-list">
        <% for (let i = 0; i < events.length; i++) { %>
        <div class="event-container">
          <div class="event-image fade-item">
            <img
              src="<%= minioUrl + events[i].image_url %>"
              alt="Bild von <%= events[i].name %>"
            />
          </div>
          <div class="event-details fade-item">
            <h2><%= events[i].name %></h2>
            <p><%= events[i].description %></p>
            <p>Preis: <%= Math.round(events[i].price) %> €</p>
            <button
              type="button"
              class="event-booking-btn"
              onclick="bookevent(JSON.parse(decodeURIComponent('<%= encodeURIComponent(JSON.stringify(events[i])) %>')))"
            >
              Event buchen
            </button>
          </div>
        </div>
        <% } %>
      </div>
      <div id="booking-form-container"></div>
    </div>
    <script>
      // These variables are set by the server-side rendering
      // and will be used in the client-side script
      window.bookingServiceUrl = "<%= bookingServiceUrl %>";

      async function bookevent(event) {
        console.log("Booking for event:", event, window.bookingServiceUrl);
        try {
          const bookingResponse = await fetch(
            `${window.bookingServiceUrl}/event-booking`,
            {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
              },
              body: JSON.stringify(event), // Important: Send body as JSON string
            }
          );

          // Check if the request was successful (HTTP status 200-299)
          if (!bookingResponse.ok) {
            const errorText = await bookingResponse.text();
            console.error(
              "Error from Booking Service:",
              bookingResponse.status,
              errorText
            );
            alert(
              "Error retrieving the booking page: " +
                (errorText || bookingResponse.statusText)
            );
            return; // Abort on error
          }

          // Extract the HTML content from the response
          const bookingHtmlContent = await bookingResponse.text();
          console.log("Received booking HTML:", bookingHtmlContent);

          // Find the container in the DOM
          const bookingContainer = document.getElementById(
            "booking-form-container"
          );

          if (bookingContainer) {
            // Insert HTML content into the container
            bookingContainer.innerHTML = bookingHtmlContent;
            // Make the container visible (if it was initially hidden)
            bookingContainer.classList.add("active");
          } else {
            console.error(
              "Error: The element 'booking-form-container' was not found."
            );
            alert(
              "An unexpected error occurred: Could not display booking area."
            );
          }
        } catch (error) {
          console.error("Fetch error:", error);
          alert("An unexpected error occurred.");
        }
      }

      function closeBookingView() {
        const bookingContainer = document.getElementById(
          "booking-form-container"
        );
        if (bookingContainer) {
          bookingContainer.innerHTML = ""; // Clear the content
          bookingContainer.classList.remove("active"); // Hide the container
        } else {
          console.error(
            "Error: The element 'booking-form-container' was not found."
          );
        }
      }

      // Fade-in effect for items in the main section
      const items = document.querySelectorAll(".fade-item");
      const itemsObserver = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target;
              const index = Array.from(items).indexOf(el);
              el.style.transitionDelay = `${0.6}s`;
              el.classList.add("visible");
              obs.unobserve(el);
            }
          });
        },
        { threshold: 0.15 }
      );

      items.forEach((el) => itemsObserver.observe(el));
    </script>
  </body>
</html>
